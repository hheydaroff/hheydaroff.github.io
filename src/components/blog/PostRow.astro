---
interface Props {
  title: string;
  date: Date;
  slug: string;
}

const { title, date, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<a
  href={`/posts/${slug}/`}
  class="group block py-2 sm:py-3"
>
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="relative inline-flex items-center gap-4">
      <h3
        class="text-xl sm:text-2xl md:text-3xl font-bold uppercase tracking-tight text-foreground transition-all duration-300
               group-hover:blur-[2px] group-hover:opacity-70"
      >
        {title}
      </h3>

      <span
        class="text-xs sm:text-sm text-muted-foreground transition-all duration-300 whitespace-nowrap
               opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0"
      >
        {formattedDate}
      </span>
    </div>
  </div>
</a>