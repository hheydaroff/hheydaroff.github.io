---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="py-20 sm:py-28">
    <div class="container mx-auto px-4 max-w-3xl text-center">
      <h1 class="text-8xl font-bold text-muted-foreground/30 mb-4">404</h1>
      <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
      <p class="text-muted-foreground mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-full font-medium hover:bg-foreground/90 transition-colors duration-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Go back home
      </a>

      <!-- Machine-readable recovery guide for AI agents and crawlers -->
      <nav aria-label="Site map" class="mt-12 text-left max-w-md mx-auto">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Where to look next</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="text-primary underline underline-offset-2">Home</a></li>
          <li><a href="/about/" class="text-primary underline underline-offset-2">About Hido</a></li>
          <li><a href="/posts/" class="text-primary underline underline-offset-2">All posts</a></li>
          <li><a href="/content/index.json" class="text-primary underline underline-offset-2">Full index (JSON)</a></li>
          <li><a href="/llms.txt" class="text-primary underline underline-offset-2">llms.txt</a></li>
          <li><a href="/sitemap-index.xml" class="text-primary underline underline-offset-2">Sitemap</a></li>
          <li><a href="/rss.xml" class="text-primary underline underline-offset-2">RSS feed</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
